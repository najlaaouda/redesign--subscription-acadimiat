# OS junk
.DS_Store
Thumbs.db
~$*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Node (in case dev tooling is added later)
node_modules/
npm-debug.log*

# Local secrets
.env
.env.local
*.local

# Claude Code workspace (keep launch.json so MCP preview still works)
.claude/settings.local.json
.claude/worktrees/

# Next.js build artifacts inside app-next/ (its own .gitignore covers
# these too, but keeping them here makes the root-level rule explicit
# for any tooling that scans only the top-level file).
app-next/.next/
app-next/node_modules/
app-next/.vercel
app-next/*.tsbuildinfo

# Temp / cache
*.tmp
.cache/

# Static prototype kept locally as design reference only — not part of
# the production app. Earlier commits (≤ 4f23f20) still contain it for
# anyone who needs to retrieve via `git checkout 4f23f20 -- legacy/`.
legacy/
